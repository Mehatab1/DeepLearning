# ---------------------------------------------------------------
# Data — published separately (see README → Dataset)
# The data folders may be symlinks on the lab server, so they are
# listed both with and without a trailing slash. A leading / matches
# only at the repository root, so results/ablation etc. stay tracked.
# ---------------------------------------------------------------
*.npz
*.npy
*.tif
*.tiff
*.vrt
*.zip
/data/
/patches/
/patches_v4
/patches_v4/
/patches_v5
/patches_v5/
/patches_v5_outer_ring/
/monthly_inputs
/monthly_inputs/
/monthly_maps/
/v5_data/

# ---------------------------------------------------------------
# Training artefacts — only the released checkpoint is tracked
# ---------------------------------------------------------------
/outputs
/outputs/
*.pt
*.pth
*.ckpt
!weights/best_unet_v5.pt

# ---------------------------------------------------------------
# Generated by the prototype and check scripts
# (curated results are kept in results/)
# ---------------------------------------------------------------
/runs/
/runs_check/
/prototype_outputs/
/arbitrary_location_test/
/accuracy_check/
/ablation/

# ---------------------------------------------------------------
# Logs and local tools
# ---------------------------------------------------------------
*.log
nohup.out
/bin/
