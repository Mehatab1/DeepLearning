# Google Cloud project registered for Earth Engine (required)
EE_PROJECT=your-gcp-project-id

# Optional: headless authentication with a service account instead of
# `earthengine authenticate` (e.g. on a server or in CI)
# EE_SERVICE_ACCOUNT=lulc-runner@your-gcp-project-id.iam.gserviceaccount.com
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
